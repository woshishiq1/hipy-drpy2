<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>荒野求生 · 開局購點</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root { --bg-0:#0e1015; --bg-1:#131722; --bg-2:#1b2030; --glass:rgba(255,255,255,0.04); --text-0:#e8ecf2; --text-1:#aab3c5; --muted:#7a8599; --brand:#7ee787; --brand-2:#6aa3ff; --warn:#ff7b7b; --chip:#2a3144; --border:#25304a; --glow:0 0 .5rem rgba(110,163,255,.25); --radius:14px; }
    *{box-sizing:border-box} html,body{min-height:100%}
    body{margin:0;overflow:auto;font-family:Inter,'Noto Sans SC',system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,'Segoe UI Emoji','Noto Color Emoji';background:radial-gradient(1200px 800px at 10% -10%,#1a1f2d 0%,#10131b 40%,#0c0f15 80%),linear-gradient(180deg,#0e1015,#0b0d12);color:var(--text-0)}
    .wrap{display:grid;grid-template-rows:auto 1fr auto;min-height:100%}
    header{padding:22px 28px;display:flex;align-items:center;justify-content:space-between;backdrop-filter:blur(8px);background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0));border-bottom:1px solid var(--border)}
    .title{display:flex;align-items:center;gap:14px;letter-spacing:.3px}
    .badge{padding:4px 10px;border-radius:999px;background:linear-gradient(180deg,#162036,#111726);border:1px solid var(--border);font-size:12px;color:var(--text-1)} h1{font-size:20px;margin:0;font-weight:700}
    .points{display:flex;align-items:center;gap:14px;padding:8px 12px;border-radius:12px;background:linear-gradient(180deg,rgba(126,231,135,.08),rgba(126,231,135,.02));border:1px solid #2a3b2f;box-shadow:var(--glow)} .points .remain{font-weight:700;color:var(--brand)} .points .spent{color:var(--text-1)}
    main{padding:26px;display:grid;gap:24px;grid-template-columns:1.3fr 1fr;position:relative;overflow:auto;max-height:72vh;-webkit-overflow-scrolling:touch}
    @media (max-width:1100px){main{grid-template-columns:1fr}}
    .panel{background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.02));border:1px solid var(--border);border-radius:var(--radius);padding:18px;box-shadow:0 20px 60px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.04);position:relative;z-index:1}
    .panel h2{margin:2px 0 14px;font-size:16px;font-weight:700;color:var(--text-0)} .hint{color:var(--muted);font-size:12px}
    .grid{display:grid;gap:14px;grid-template-columns:repeat(2,minmax(0,1fr))} @media (max-width:640px){.grid{grid-template-columns:1fr}}
    .item{background:var(--glass);border:1px solid var(--border);border-radius:12px;padding:12px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px}
    .item .name{font-weight:600} .item .meta{color:var(--muted);font-size:12px} .item .desc{color:var(--text-1);font-size:12px;line-height:1.5;margin-top:4px} .ctrls{display:flex;align-items:center;gap:8px}
    .btn{appearance:none;border:1px solid var(--border);color:var(--text-0);background:#171c2a;border-radius:8px;padding:6px 10px;cursor:pointer}
    .btn:hover{background:#1a2132} .btn:disabled{opacity:.5;cursor:not-allowed} .chip{padding:4px 8px;border-radius:999px;background:var(--chip);color:var(--text-1);font-size:12px;border:1px solid var(--border)}
    .seg-title{margin:18px 0 8px;font-weight:700;font-size:14px;color:var(--text-1)} .divider{height:1px;background:var(--border);margin:12px 0}
    .attr-ctrl{display:flex;align-items:center;gap:8px} .attr-value{font-weight:700;min-width:40px;text-align:center;color:var(--brand-2)} .count{min-width:22px;text-align:center}
    .toggle{display:flex;align-items:center;gap:10px} .toggle input{width:18px;height:18px}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px} @media (max-width:640px){.two-col{grid-template-columns:1fr}}
    @media (max-width:480px){header{flex-direction:column;gap:12px;padding:16px;text-align:center}.difficulty{order:3;width:100%;justify-content:center}.points{order:2}main{grid-template-columns:1fr;padding:16px;gap:16px;max-height:none;overflow-y:auto}.panel{padding:14px}.item{grid-template-columns:1fr;gap:8px}.ctrls{justify-content:center;margin-top:8px}.attr-ctrl{justify-content:center}.two-col{grid-template-columns:1fr;gap:16px}.footer{flex-direction:column;gap:12px;padding:16px}.primary,.ghost{width:100%}}
    @media (max-width:360px){header .difficulty{flex-wrap:wrap;justify-content:center}.difficulty .btn{padding:6px 8px;font-size:13px}h1{font-size:18px}.panel h2{font-size:15px}.seg-title{font-size:13px}}
    /* 移除下方高光特效 */
    .summary{display:grid;gap:10px;background:linear-gradient(180deg,rgba(110,163,255,.05),rgba(110,163,255,.02));border:1px solid #22314b;border-radius:12px;padding:12px}
    .summary .line{display:flex;justify-content:space-between;color:var(--text-1)} .summary .line b{color:var(--text-0)}
    textarea{width:100%;min-height:96px;resize:vertical;padding:10px;border-radius:10px;border:1px solid var(--border);background:#121724;color:var(--text-0)}
    .footer{display:flex;justify-content:space-between;align-items:center;padding:16px 26px;border-top:1px solid var(--border);background:linear-gradient(0deg,rgba(255,255,255,.03),rgba(255,255,255,0))}
    .primary{background:linear-gradient(180deg,#3a64ff,#2446c9);border:1px solid #2a3d98;color:#fff;padding:10px 16px;border-radius:10px;font-weight:700;cursor:pointer;box-shadow:0 10px 24px rgba(36,70,201,.35),inset 0 1px 0 rgba(255,255,255,.22)} .primary:disabled{opacity:.6;cursor:not-allowed}
    .ghost{background:transparent;border:1px solid var(--border);color:var(--text-0);padding:10px 14px;border-radius:10px}
    .error{color:var(--warn);font-size:12px}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="title">
        <span class="badge" id="badgeDifficulty">標準 · 100 點</span>
        <h1>荒野求生 · 開局購點</h1>
      </div>
      <div class="difficulty" style="display:flex;gap:8px;align-items:center;">
        <span class="hint">難度</span>
        <button class="btn" data-diff="hard">困難 50</button>
        <button class="btn" data-diff="normal">標準 100</button>
        <button class="btn" data-diff="easy">簡單 200</button>
        <button class="btn" data-diff="superEasy">超級簡單 400</button>
      </div>
      <div class="points">
        <span class="spent">已用 <b id="spent">0</b></span>
        <span class="remain">剩餘 <b id="remain">100</b></span>
      </div>
    </header>

    <main>
      <section class="panel" id="left">
        <h2>分配與選擇</h2>
        <div class="hint">點選 + / − 調整，所見即所得。所有資料可在指令碼頂部配置。</div>

        <div class="seg-title">屬性（基礎 20，每 +1 花費 5）</div>
        <div class="grid" id="attrGrid"></div>

        <div class="divider"></div>

        <div class="seg-title">技能</div>
        <div class="grid" id="skillGrid"></div>

        <div class="divider"></div>

        <div class="seg-title">物品</div>
        <div class="grid" id="itemGrid"></div>

        <div class="divider"></div>

        <div class="seg-title">天賦 或 狀態</div>
        <div class="two-col">
          <div>
            <div class="hint">正面（消耗點數）</div>
            <div class="grid" id="traitPosGrid"></div>
          </div>
          <div>
            <div class="hint">負面（返還點數）</div>
            <div class="grid" id="traitNegGrid"></div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="seg-title">職業</div>
        <div class="grid" id="careerGrid"></div>

        <div class="divider"></div>

        <div class="seg-title">出生點</div>
        <div class="grid" id="birthGrid"></div>

        <div class="divider"></div>

        <div class="seg-title">自定義設定</div>
        <textarea id="custom" placeholder="在此填寫你希望在劇情/世界觀/規則上的自定義偏好或補充,比如身邊躺著個貓娘..."></textarea>
      </section>

      <aside class="panel" id="right">
        <h2>總覽</h2>
        <div class="summary" id="summary"></div>
        <div class="divider"></div>
        <div class="hint">提示：若點數超出預算，將無法確認。</div>
        <div class="error" id="error" style="display:none;">點數不足或選擇不合法，請檢查。</div>
      </aside>
    </main>

    <div class="footer">
      <button class="ghost" id="resetBtn">重置選擇</button>
      <button class="primary" id="confirmBtn">確認併傳送至 LLM</button>
    </div>
  </div>

  <script>
const CONFIG = {
  difficulties: { hard: 50, normal: 100, easy: 200,superEasy: 400, simple: 400 },
  attributes: { base: 20, min: 20, max: 40, costPerPoint: 5, list: ['力量','敏捷','耐力','智力','感知','意志'] },
  skills: [
    // 戰鬥類
    { id:'melee_combat', name:'白刃戰', costPerRank:15, maxRank:5, desc:'允許你有效使用近戰武器。每級為你的近戰攻擊和招架檢定提供+5加值。' },
    { id:'ranged_combat', name:'投擲及射擊', costPerRank:15, maxRank:5, desc:'允許你有效使用遠端武器。每級為你的遠端攻擊檢定提供+5加值，並增加10%的有效射程。' },
    // 採集類
    { id:'foraging', name:'採集辨識', costPerRank:15, maxRank:5, desc:'允許你進行採集檢定以尋找食物和草藥。每級為該檢定提供+5加值，並能辨識更多種類的植物。' },
    { id:'tracking', name:'狩獵追蹤', costPerRank:12, maxRank:5, desc:'允許你進行追蹤檢定。每級為該檢定提供+5加值，並能從蹤跡中解讀出更精確的資訊（如數量、方向、時間）。' },
    { id:'prospecting', name:'礦脈勘探', costPerRank:15, maxRank:5, desc:'允許你進行找礦檢定。每級為該檢定提供+5加值，並能從地質特徵中解讀出更精確的資訊（如礦種、礦脈走向、大致深度與品質）。' },
    { id:'fishing', name:'漁獵', costPerRank:12, maxRank:5, desc:'允許你在有水源的地方進行漁獵檢定。每級為該檢定提供+5加值，並能判斷更佳的捕魚地點。' },
    // 製作類
    { id:'construction', name:'基礎建築', costPerRank:18, maxRank:5, desc:'允許你進行建築檢定。每級為該檢定提供+5加值，並解鎖更復雜、更堅固的建築藍圖。' },
    { id:'crafting', name:'製作及工匠', costPerRank:18, maxRank:5, desc:'允許你進行製作檢定。每級為該檢定提供+5加值，並解鎖更高階的工具和物品製作配方。' },
    { id:'cooking', name:'烹飪調理', costPerRank:11, maxRank:5, desc:'允許你進行烹飪檢定。每級為該檢定提供+5加值。成功的烹飪會使食物的營養價值提升20%。' },
    // 知識/輔助類
    { id:'stealth', name:'潛行與偽裝', costPerRank:10, maxRank:5, desc:'允許你進行潛行檢定以避免被發現。每級為該檢定提供+5加值。' },
    { id:'survival', name:'野外生存',      costPerRank:20, maxRank:5, desc:'一項綜合技能，每級為導航、尋找水源、天氣預測等非特定的野外生存檢定提供+5加值。' },
    { id:'med',      name:'醫療救護',      costPerRank:15, maxRank:5, desc:'允許你進行高階醫療檢定。每級為該檢定提供+5加值，可處理骨折、感染等複雜傷病。' },
    { id:'climb',    name:'攀爬及繩索技巧', costPerRank:12, maxRank:5, desc:'允許你進行攀爬和使用繩索的檢定。每級為該檢定提供+5加值，並減少體力消耗。' },
    { id:'trapping', name:'陷阱與捕獵',   costPerRank:12, maxRank:5, desc:'允許你進行陷阱佈置檢定。每級為該檢定提供+5加值，並解鎖更高效的陷阱知識。' },
    { id:'water',    name:'涉水及水上技巧', costPerRank:10, maxRank:5, desc:'允許你進行遊泳、划船等水上活動檢定。每級為該檢定提供+5加值，並減少10%的水中體力消耗。' }
  ],
  items: [
    // 核心工具
    { id:'heavy_axe', name:'重型多功能斧', cost:35, maxQty:1, desc:'伐木、建造和防身的最佳伴侶，能極大提高木材採集效率。提供+15相關檢定加值。' },
    { id:'knife',      name:'軍用匕首',         cost:20,  maxQty:1, desc:'輕便近戰與割切工具。使用時對近戰/製作類檢定 +5 。' },
    { id:'fishing_kit', name:'漁夫的工具包', cost:10, maxQty:1, desc:'包含了一卷堅韌的魚線、幾個骨制魚鉤和一些羽毛擬餌，極大提升釣魚成功率。' },
    { id:'multitool',  name:'瑞士刀',       cost:30,  maxQty:1, desc:'小型修理/裁切/開瓶/扳手集合體。對修理與製作檢定 +10 。' },
    { id:'multitool_shovel', name:'多功能工兵鏟', cost:80, maxQty:1, desc:'鏟／鋸／鎬／開瓶／起釘／量尺集合體。對挖掘、砍劈、野營製作檢定 +15 。' },
    { id:'Chain_saw_machine',  name:'鏈鋸機',       cost:50,  maxQty:1, desc:'專門伐木的機器，已經加滿汽油了。對伐木檢定 +100 。' },

    // 生存輔助
    { id:'tarp', name:'軍用防水油布', cost:15, maxQty:1, desc:'一塊輕便但堅韌的油布，可以快速搭建起一個有效的臨時避雨棚，防止失溫。' },
    { id:'backpack', name:'大容量登山包', cost:18, maxQty:1, desc:'經過人體工程學設計的揹包，能讓你攜帶比平時更多的物資，且消耗更少的體力。' },
    { id:'trap_kit', name:'簡易陷阱套組', cost:12, maxQty:1, desc:'包含幾個繩套、觸發器和一個金屬捕獸夾，讓你在開局就能穩定獲得小型獵物。' },
    { id:'surgical_kit', name:'醫用手術包', cost:15, maxQty:1, desc:'包含縫合針、消毒酒精和抗生素，能處理非常嚴重的傷口，避免致命的感染。(可使用兩次)' },
    { id:'iron_kettle', name:'鐵茶壺', cost:25, maxQty:1, desc:'2公升容量，可直火加熱煮水。煮沸生水可降低疾病風險；裝盛熱飲防止失溫；重複使用（耐用）。' },
    { id:'fold_bucket', name:'折疊式塑膠水桶', cost:15, maxQty:2, desc:'25公升容量，可折疊收納。大量取水／儲水／清洗用途；不耐火；重複使用（易磨損）。' },

    // 消耗品
    { id:'rations', name:'高熱量壓縮餅乾', cost:9, maxQty:3, desc:'提供緊急情況下的能量來源，讓你能專注於建立營地而不是尋找食物。' },
    { id:'water_purification_tablets', name:'淨水藥片 ', cost:12, maxQty:50, desc:'能快速淨化飲水，避免因飲用不潔水源而生病。' },
    { id:'rope_20m', name:'一捆結實的繩索', cost:12, maxQty:2, desc:'用途極其廣泛，可用於捆綁、攀爬、製作工具和陷阱。' },
    { id:'tent',     name:'輕型帳篷',         cost:40,  maxQty:1, desc:'舒適度加成。提供庇護, 方便拆卸可移動（耐用，可重複使用）。' },
    { id:'binoculars', name:'望遠鏡',   cost:15,  maxQty:1, desc:'遠距偵查時對感知/偵查檢定 +10 判定點（長期可重複使用）。' },
    { id:'dogmeat', name:'狗肉',   cost:40,  maxQty:1, desc:'一隻德國黑背犬, 能給你陪伴, 或許也能幫助你打獵? 不過你也需要負責它的食物.' },
    { id:'debt', name:'賭狗', cost:100, maxQty:1, desc:'獲得600點求生點數, 至於會抽到什麼就看命吧.' },

  ],
  traits: {
    positive: [
      { id:'survival_instinct', name:'生存本能', cost:40, desc:'你與荒野心意相通。所有“採集辨識”、“狩獵追蹤”和“漁獵”檢定自動獲得+15背景加值。' },
      { id:'master_craftsman', name:'巧匠之心', cost:35, desc:'你天生擅長變廢為寶。所有“基礎建築”和“製作/工匠”檢定自動獲得+15背景加值。' },
      { id:'thick_skin', name:'厚皮', cost:15, desc:'你的皮膚堅韌如革，更加難以受傷。' },
      { id:'boundless_energy', name:'精力旺盛', cost:22, desc:'你的體力恢復速度驚人。每次透過休息恢復耐力時，額外恢復耐力值30%。' },
      { id:'night_vision', name:'夜視能力', cost:12, desc:'你的眼睛能適應黑暗。在低光照環境下，因光線不足受到的感知檢定懲罰減半。' },
      { id:'brave', name:'臨危不懼（勇敢）', cost:15, desc:'你的意志堅定。在進行所有對抗恐懼、恐慌或精神壓力的意志豁免時，獲得+10加值。' },
      { id:'keen',  name:'敏銳直覺',   cost:35, desc:'你的感官異常敏銳。在進行有意識的偵查、搜尋檢定時獲得+10加值。' },
      { id:'strong_immunity',  name:'強免疫力',   cost:25, desc:'你的免疫力比常人更加強大, 獲得免疫負荷時將減少50%.' },
      { id:'fisher',  name:'釣魚佬',   cost:25, desc:'釣魚佬永不空軍!（希望）. 釣魚時獲得+20檢定' },

    ],
    negative: [
      { id:'allergies', name:'過敏體質', cost:-12, desc:'你對特定物質（如花粉、昆蟲）過敏。暴露在這種環境中時，所有檢定受到-10的生理懲罰，直到脫離環境。' },
      { id:'fastidious', name:'潔癖', cost:-10, desc:'你無法忍受骯髒。在不潔環境中休息，或情節程度低將會增加壓力值。食用生食或飲用不潔淨水對免疫負荷的影響更大' },
      { id:'pessimistic', name:'悲觀主義者', cost:-10, desc:'你總是預想最壞的結果。當你的一次重要檢定失敗時，必須進行一次意志豁免，若失敗則陷入“士氣低落”狀態（所有檢定-10），持續1小時。' },
      { id:'heavy_footed', name:'沉重腳步', cost:-10, desc:'你走路的聲音很大。所有“潛行與偽裝”檢定受到-10的固定懲罰。' },
