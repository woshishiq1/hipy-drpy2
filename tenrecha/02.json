    function renderTraits(){ el.traitPosGrid.innerHTML=''; for(const t of CONFIG.traits.positive){ const wrap=document.createElement('div'); wrap.className='item'; const checked=state.traitsPos.has(t.id)?'checked':''; wrap.innerHTML=`<div><div class="name">${t.name}</div><div class="meta">花費 ${t.cost} · ${t.desc||''}</div></div><label class="toggle"><input type="checkbox" ${checked}><span class="chip">選擇</span></label>`; const input=wrap.querySelector('input'); input.addEventListener('change',()=>{ if(input.checked) state.traitsPos.add(t.id); else state.traitsPos.delete(t.id); updateAll(); }); el.traitPosGrid.appendChild(wrap);} el.traitNegGrid.innerHTML=''; for(const t of CONFIG.traits.negative){ const wrap=document.createElement('div'); wrap.className='item'; const checked=state.traitsNeg.has(t.id)?'checked':''; wrap.innerHTML=`<div><div class="name">${t.name}</div><div class="meta">返還 ${Math.abs(t.cost)} · ${t.desc||''}</div></div><label class="toggle"><input type="checkbox" ${checked}><span class="chip">選擇</span></label>`; const input=wrap.querySelector('input'); input.addEventListener('change',()=>{ if(input.checked) state.traitsNeg.add(t.id); else state.traitsNeg.delete(t.id); updateAll(); }); el.traitNegGrid.appendChild(wrap);} }
    function renderCareers(){ el.careerGrid.innerHTML=''; for(const b of CONFIG.careers){ const wrap=document.createElement('div'); wrap.className='item'; const chosen=state.career===b.id; wrap.innerHTML=`<div><div class="name">${b.name}</div><div class="meta">${b.desc||''} · 花費 ${b.cost}</div></div><div class="ctrls"><button class="btn" ${chosen?'disabled':''}>${chosen?'已選擇':'選擇'}</button></div>`; wrap.querySelector('.btn').addEventListener('click',()=>{ state.career=b.id; renderCareers(); updateAll(); }); el.careerGrid.appendChild(wrap);} }
    function renderBirthpoints(){ el.birthGrid.innerHTML=''; for(const b of CONFIG.birthpoints){ const wrap=document.createElement('div'); wrap.className='item'; const chosen=state.birthpoint===b.id; wrap.innerHTML=`<div><div class="name">${b.name}</div><div class="meta">${b.desc||''} · 花費 ${b.cost}</div></div><div class="ctrls"><button class="btn" ${chosen?'disabled':''}>${chosen?'已選擇':'選擇'}</button></div>`; wrap.querySelector('.btn').addEventListener('click',()=>{ state.birthpoint=b.id; renderBirthpoints(); updateAll(); }); el.birthGrid.appendChild(wrap);} }
    function renderSummary(){ const {spent,remain}=calcCosts(); el.spent.textContent=spent; el.remain.textContent=remain; el.err.style.display=remain<0?'block':'none'; el.confirm.disabled=remain<0; const parts=[]; const attrsLine=CONFIG.attributes.list.map(n=>`${n}: ${state.attrs[n]}`).join(' · '); parts.push(`<div class="line"><span>屬性</span><b>${attrsLine}</b></div>`); const skillPicks = CONFIG.skills.filter(s => (state.skills.get(s.id) || 0) > 0).map(s => `${s.name}×${state.skills.get(s.id)}`).join(`，`) || `無`; parts.push(`<div class="line"><span>技能</span><b>${skillPicks}</b></div>`); const itemPicks = CONFIG.items.filter(it => (state.items.get(it.id) || 0) > 0).map(it => `${it.name}×${state.items.get(it.id)}`).join(`，`) || `無`; parts.push(`<div class="line"><span>物品</span><b>${itemPicks}</b></div>`); const pos=CONFIG.traits.positive.filter(t=>state.traitsPos.has(t.id)).map(t=>t.name).join('，')||'無'; const neg=CONFIG.traits.negative.filter(t=>state.traitsNeg.has(t.id)).map(t=>t.name).join('，')||'無'; parts.push(`<div class="line"><span>天賦</span><b>正面：${pos} ｜ 負面：${neg}</b></div>`); const c=CONFIG.careers.find(x=>x.id===state.career); parts.push(`<div class="line"><span>職業</span><b>${c?c.name:'未選擇'}</b></div>`); const o=(CONFIG.birthpoints||[]).find(x=>x.id===state.birthpoint); parts.push(`<div class="line"><span>出生點</span><b>${o?o.name:'未選擇'}</b></div>`); parts.push(`<div class="line"><span>預算</span><b>已用 ${spent} ｜ 剩餘 ${remain} ｜ 難度 ${state.difficultyLabel}（${state.budget}）</b></div>`); parts.push(`<div class="line"><span>自定義</span><b>${state.custom?state.custom.replace(/</g,'&lt;').replace(/>/g,'&gt;'):'（空）'}</b></div>`); el.summary.innerHTML=parts.join(''); }
