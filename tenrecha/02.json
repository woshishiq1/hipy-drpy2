    function renderAttrs(){ el.attrGrid.innerHTML=''; for(const n of CONFIG.attributes.list){ const v=state.attrs[n]; const wrap=document.createElement('div'); wrap.className='item'; wrap.innerHTML=`<div><div class="name">${n}</div><div class="meta">基礎 ${CONFIG.attributes.base} · 每 +1 花費 ${CONFIG.attributes.costPerPoint}</div></div><div class="ctrls attr-ctrl"><button class="btn" data-a="-">−</button><div class="attr-value">${v}</div><button class="btn" data-a="+">＋</button></div>`; const [bMinus, val, bPlus]=wrap.querySelectorAll('.btn, .attr-value'); bMinus.addEventListener('click',()=>{ state.attrs[n]=Math.max(CONFIG.attributes.min,state.attrs[n]-1); val.textContent=state.attrs[n]; updateAll(); }); bPlus.addEventListener('click',()=>{ state.attrs[n]=Math.min(CONFIG.attributes.max,state.attrs[n]+1); val.textContent=state.attrs[n]; updateAll(); }); el.attrGrid.appendChild(wrap);} }
