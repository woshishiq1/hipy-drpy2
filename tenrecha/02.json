    (function setupDifficulty(){ const badge=el.badge; const map=CONFIG.difficulties; const label={hard:'困難',normal:'標準',easy:'簡單', superEasy: '超級簡單'}; document.querySelectorAll('[data-diff]').forEach(btn=>btn.addEventListener('click',()=>{ const key=btn.getAttribute('data-diff'); state.difficulty=key; state.difficultyLabel=label[key]||'標準'; state.budget=map[key]||100; if(badge) badge.textContent=`${state.difficultyLabel} · ${state.budget} 點`; updateAll(); })); if(badge) badge.textContent=`${state.difficultyLabel} · ${state.budget} 點`; })();

    function buildTextForLLM(){
  const { spent, remain } = calcCosts();
  const q = (v) => JSON.stringify(String(v ?? ''));
  const n = (v) => Number.isFinite(v) ? v : Number(v) || 0;

  const attrsBlock = CONFIG.attributes.list
    .map((name) => `  - name: ${q(name)}\n    value: ${n(state.attrs[name])}`)
    .join('\n');

  const skillsBlock = CONFIG.skills
    .filter((s) => (state.skills.get(s.id) || 0) > 0)
    .map((s) => `  - id: ${q(s.id)}\n    name: ${q(s.name)}\n    rank: ${n(state.skills.get(s.id) || 0)}\n    cost_per_rank: ${n(s.costPerRank)}\n    max_rank: ${n(s.maxRank)}\n    desc: ${q(s.desc)}`)
    .join('\n');

  const itemsBlock = CONFIG.items
    .filter((it) => (state.items.get(it.id) || 0) > 0)
    .map((it) => `  - id: ${q(it.id)}\n    name: ${q(it.name)}\n    qty: ${n(state.items.get(it.id) || 0)}\n    cost: ${n(it.cost)}\n    max_qty: ${n(it.maxQty)}\n    desc: ${q(it.desc)}`)
    .join('\n');

  const pickedPos = CONFIG.traits.positive.filter(t => state.traitsPos.has(t.id));
  const pickedNeg = CONFIG.traits.negative.filter(t => state.traitsNeg.has(t.id));
  const posBlock = pickedPos.length
    ? pickedPos.map((t) => `    - id: ${q(t.id)}\n      name: ${q(t.name)}\n      cost: ${n(t.cost)}\n      desc: ${q(t.desc)}`).join('\n')
    : '    []';
  const negBlock = pickedNeg.length
    ? pickedNeg.map((t) => `    - id: ${q(t.id)}\n      name: ${q(t.name)}\n      cost: ${n(t.cost)}\n      desc: ${q(t.desc)}`).join('\n')
    : '    []';

  const career = CONFIG.careers.find(x => x.id === state.career) || null;
  const birth = (CONFIG.birthpoints || []).find(x => x.id === state.birthpoint) || null;

  const careerBlock = career
    ? `id: ${q(career.id)}\n  name: ${q(career.name)}\n  cost: ${n(career.cost)}\n  desc: ${q(career.desc)}`
    : 'null';
  const birthBlock = birth
    ? `id: ${q(birth.id)}\n  name: ${q(birth.name)}\n  cost: ${n(birth.cost)}\n  desc: ${q(birth.desc)}`
    : 'null';

  const custom = (state.custom || '').trim();
  const customLine = `custom: ${custom ? q(custom) : '""'}`;

  const yaml = [
    '歡迎來到荒野世界---快醒醒吧，不然要被野獸吃掉了！',
    '---',
    '<choice>',
    'attributes(此處為直接設定屬性等級):',
    attrsBlock || '  []',
    'skills(此處為直接建立天賦特性):',
    skillsBlock || '  []',
    'items:',
    itemsBlock || '  []',
    'traits:',
    '  positive:',
    posBlock,
    '  negative:',
    negBlock,
    'career:',
    career ? `  ${careerBlock.replace(/\n/g, '\n  ')}` : '  null',
    'birthpoint:',
    birth ? `  ${birthBlock.replace(/\n/g, '\n  ')}` : '  null',
    customLine, 
    '要求: 根據以上給出的資訊, 寫一段身臨其境帶點黑色幽默的穿越開場，最終生成一個簡單情境，另外請將小黑板建立到攜帶物品中(記得建立完整功能)，還有要把主線、支線任務變量及當前目標直接建立起來，在此次無視刷新規則立即刷新機會與命運的所有線索，並刷新商店，在最後根據給出的開局條件寫入變數。',
    '</choice>'
  ].join('\n');

  return yaml;
}async function sendToSillyTavern(){ const {remain}=calcCosts(); if(remain<0) return; const text=buildTextForLLM(); const stVars={ DIFFICULTY: state.difficultyLabel, BUDGET: String(state.budget), SPENT: String(state.budget - remain), REMAIN: String(remain), SURVIVAL_POINTS: String(0)}; try{ if(typeof insertOrAssignVariables==='function'){ await insertOrAssignVariables(stVars);} if(typeof triggerSlash==='function'){ const slash=`/send <START>\n${text}\n|\n/trigger`; await triggerSlash(slash,'Send'); return; } }catch(e){ console.warn('SillyTavern 整合失敗，轉為剪貼簿複製。',e);} try{ await navigator.clipboard.writeText(text); alert('已複製到剪貼簿，請貼上到聊天。'); }catch(e){ alert('無法複製到剪貼簿，請手動複製總覽文字。'); console.log(text);} }
    document.getElementById('confirmBtn').addEventListener('click', sendToSillyTavern);

    (function boot(){ state.difficulty='normal'; state.difficultyLabel='標準'; state.budget=CONFIG.difficulties.normal; renderAttrs(); renderSkills(); renderItems(); renderTraits(); renderCareers(); renderBirthpoints(); updateAll(); })();
  </script>
